{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mini-messenger-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mini-messenger-db",
      "migrations_dir": "migrations"
    }
  ]
}
