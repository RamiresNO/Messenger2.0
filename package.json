{
  "name": "study-hall-messenger",
  "version": "1.0.0",
  "private": true,
  "description": "A persistent web messenger for study groups",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "python app.py",
    "dev": "python app.py",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "dev:cloudflare": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply mini-messenger-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mini-messenger-db --remote",
    "deploy:cloudflare": "wrangler deploy",
    "test": "npm run test:python"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.0"
  }
}
